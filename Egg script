local function getPromptPart(prompt)
    if prompt.Parent and prompt.Parent:IsA("BasePart") then
        return prompt.Parent
    elseif prompt.Parent and prompt.Parent:IsA("Attachment") then
        local parent = prompt.Parent.Parent
        if parent and parent:IsA("BasePart") then
            return parent
        end
    end
    return nil
end

local function getPromptDistance(prompt)
    local root = getRoot()
    if not root then return math.huge end

    local part = getPromptPart(prompt)
    if not part then return math.huge end

    return (root.Position - part.Position).Magnitude
end

local function isPromptInRange(prompt)
    local distance = getPromptDistance(prompt)
    local maxDistance = prompt.MaxActivationDistance or 10

    return distance <= maxDistance
end

local function HoldPromptFull(prompt, cancelFn)
    if not prompt or not prompt.Parent then return false end

    local holdDuration = prompt.HoldDuration
    if not holdDuration or holdDuration <= 0 then
        holdDuration = 0.5
    end

    Log("HoldPromptFull: зажал промт на", holdDuration, "сек")

    local ok = pcall(function()
        prompt:InputHoldBegin()
    end)

    if not ok then
        Log("HoldPromptFull: InputHoldBegin FAILED")
        return false
    end

    local startTime = os.clock()
    local totalTime = holdDuration + 0.2

    while os.clock() - startTime < totalTime do
        if type(cancelFn) == "function" and cancelFn() then
            break
        end
        if not prompt.Parent then break end
        task.wait(0.05)
    end

    pcall(function()
        prompt:InputHoldEnd()
    end)

    Log("HoldPromptFull: отпустил промт")
    task.wait(0.2)

    return true
end

local function holdPrompt(prompt)
    if activePrompts[prompt] then return end
    if isHoldingPrompt then return end

    activePrompts[prompt] = true
    isHoldingPrompt = true

    task.spawn(function()
        HoldPromptFull(prompt, function()
            return not autoEggEnabled
        end)
        isHoldingPrompt = false
        activePrompts[prompt] = nil
    end)
end

local function trackPrompt(prompt)
    if not prompt:IsA("ProximityPrompt") then return end
    if trackedPrompts[prompt] then return end
    trackedPrompts[prompt] = true
end

local function scanPrompts()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") then
            trackPrompt(obj)
        end
    end
end

local function checkPrompts()
    if not autoEggEnabled then return end
    if isHoldingPrompt then return end

    for prompt in pairs(activePrompts) do
        if not prompt or not prompt.Parent or not isPromptInRange(prompt) then
            activePrompts[prompt] = nil
        end
    end

    local nearestPrompt = nil
    local nearestDist = math.huge

    for prompt in pairs(trackedPrompts) do
        if prompt and prompt.Parent and prompt.Enabled and not activePrompts[prompt] then
            if isPromptInRange(prompt) then
                local dist = getPromptDistance(prompt)
                if dist < nearestDist then
                    nearestDist = dist
                    nearestPrompt = prompt
                end
            end
        elseif not prompt or not prompt.Parent then
            trackedPrompts[prompt] = nil
        end
    end

    if nearestPrompt then
        holdPrompt(nearestPrompt)
    end
end

local function startAutoEgg()
    trackedPrompts = {}
    activePrompts = {}

    scanPrompts()

    descendantConnection = workspace.DescendantAdded:Connect(function(obj)
        if not autoEggEnabled then return end
        if obj:IsA("ProximityPrompt") then
            trackPrompt(obj)
        end
    end)

    autoEggConnection = RunService.Heartbeat:Connect(function()
        if not autoEggEnabled then return end
        checkPrompts()
    end)
end

local function stopAutoEgg()
    if autoEggConnection then
        autoEggConnection:Disconnect()
        autoEggConnection = nil
    end

    if descendantConnection then
        descendantConnection:Disconnect()
        descendantConnection = nil
    end

    for prompt in pairs(activePrompts) do
        pcall(function()
            prompt:InputHoldEnd()
        end)
    end

    activePrompts = {}
    trackedPrompts = {}
end

local function findStealPrompt(centerPos, radius)
    local root = getRoot()
    if not root then return nil end

    local nearest = nil
    local nearestDist = math.huge

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") and obj.Enabled then
            local txt = string.lower(tostring(obj.ActionText or ""))
            if string.find(txt, "steal") then
                local part = getPromptPart(obj)
                if part then
                    local distToCenter = (centerPos - part.Position).Magnitude
                    local distToMe = (root.Position - part.Position).Magnitude

                    if distToCenter <= radius and distToMe < nearestDist then
                        nearestDist = distToMe
                        nearest = obj
                    end
                end
            end
        end
    end

    return nearest
end

local function isPlayerStuck()
    if Steal.Carrying then return false end
    if isHoldingPrompt then return false end

    local humanoid = getHumanoid()
    if not humanoid then return true end

    local state = humanoid:GetState()
    if state == Enum.HumanoidStateType.Physics then return true end
    if state == Enum.HumanoidStateType.FallingDown then return true end
    if state == Enum.HumanoidStateType.Ragdoll then return true end
    if humanoid.PlatformStand then return true end

    return false
end

local function waitForArrival(targetPos, timeout)
    local startTime = os.clock()

    while autoEggsEnabled do
        if Steal.Carrying then
            return false, "carrying"
        end

        local humanoid = getHumanoid()
        local root = getRoot()

        if not humanoid or not root then
            task.wait(0.1)
            continue
        end

        if isPlayerStuck() then
            return false, "stuck"
        end

        humanoid:MoveTo(targetPos)

        local distance = (root.Position - targetPos).Magnitude

        if distance < 3 then
            return true, "arrived"
        end

        if os.clock() - startTime > (timeout or 15) then
            return false, "timeout"
        end

        task.wait(0.1)
    end

    return false, "disabled"
end

local function autoEggsLoop()
    if not autoEggsEnabled then return end

    local humanoid = getHumanoid()
    if not humanoid or humanoid.Health <= 0 then return end

    Log("autoEggsLoop: старт, Carrying:", Steal.Carrying, "ReturnActive:", ReturnThreadActive)

    if ReturnThreadActive then
        Log("autoEggsLoop: поток возврата активен, ждём сдачи...")

        local waitStart = os.clock()
        while ReturnThreadActive and os.clock() - waitStart < 60 and autoEggsEnabled do
            task.wait(0.3)
        end

        Log("autoEggsLoop: поток возврата завершён")
        task.wait(1)
        return
    end

    if Steal.Carrying then
        if AntiGuardEnabled then
            task.wait(1)
            return
        end

        Log("autoEggsLoop: яйцо в руках, запускаю поток возврата")
        StartReturnThread()

        local waitStart = os.clock()
        while ReturnThreadActive and os.clock() - waitStart < 60 and autoEggsEnabled do
            task.wait(0.3)
        end

        task.wait(1)
        return
    end

    if not prePointDone then
        local preArrived, reason = waitForArrival(PRE_POINT, 30)

        if reason == "carrying" then
            Log("autoEggsLoop: прервано на пре-точке")
            return
        end

        if not preArrived then
            Window:Notify("Авто яйца", "Не дошёл до пре-точки, повтор...", "warn")
            task.wait(0.5)
            return
        end

        prePointDone = true
    end

    local targetPos = LOCATIONS[selectedLocation]
    if not targetPos then
        Window:Notify("Авто яйца", "Локация не найдена!", "error")
        return
    end

    while autoEggsEnabled do
        local arrived, reason = waitForArrival(targetPos, 30)

        if reason == "carrying" then
            Log("autoEggsLoop: прервано на пути")
            return
        end

        if not autoEggsEnabled then return end
        if arrived then break end

        if reason == "stuck" then
            Window:Notify("Авто яйца", "Игрок в рагдолле, повтор...", "warn")
        else
            Window:Notify("Авто яйца", "Не дошёл до локации, повтор...", "warn")
        end
        task.wait(0.5)
    end

    if not autoEggsEnabled then return end
    task.wait(0.3)

    local nearestEgg = FindNearestEggNear(targetPos, 150)

    if nearestEgg and typeof(nearestEgg.BottomCFrame) == "CFrame" then
        local eggPos = nearestEgg.BottomCFrame.Position
        local tpPos = eggPos + Vector3.new(0, 3, 0)

        Log("Телепорт к яйцу, uid:", nearestEgg.Uid)

        local root = getRoot()
        if root then
            pcall(function()
                root.CFrame = CFrame.new(tpPos)
                root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
            end)

            task.wait(0.3)
        end
    end

    if not autoEggsEnabled then return end

    if not lockedPrompt or not lockedPrompt.Parent or not lockedPrompt.Enabled then
        lockedPrompt = findStealPrompt(targetPos, 80)
    end

    local stealPrompt = lockedPrompt

    if stealPrompt and autoEggsEnabled then
        local promptPart = getPromptPart(stealPrompt)
        if promptPart then
            Log("Нашёл Steal промт, полное удержание")

            local root = getRoot()
            local humanoid2 = getHumanoid()
            if root and humanoid2 then
                local dist = (root.Position - promptPart.Position).Magnitude
                if dist > 5 then
                    humanoid2:MoveTo(promptPart.Position)
                    local waitStart = os.clock()
                    while os.clock() - waitStart < 5 and autoEggsEnabled do
                        if Steal.Carrying then break end
                        local r = getRoot()
                        if r and (r.Position - promptPart.Position).Magnitude < 5 then break end
                        task.wait(0.1)
                    end
                end
            end

            if not autoEggsEnabled then return end
            if Steal.Carrying then
                Log("autoEggsLoop: яйцо уже в руках перед удержанием!")
                return
            end

            isHoldingPrompt = true
            Steal.Active = true

            HoldPromptFull(stealPrompt, function()
                return not autoEggsEnabled
            end)

            isHoldingPrompt = false
            lockedPrompt = nil
            Log("Удержание завершено, Carrying:", Steal.Carrying)
        end
    else
        Log("Steal промт НЕ найден!")
        Window:Notify("Авто яйца", "Промт 'Steal' не найден!", "warn")
    end

    Steal.Active = false

    task.wait(1)

    if Steal.Carrying then
        if AntiGuardEnabled then
            return
        end

        Log("autoEggsLoop: яйцо стабильно! Запускаю поток возврата")
        Window:Notify("Авто яйца", "✅ Яйцо в руках, несу домой!", "success", 3)
        StartReturnThread()

        local waitStart = os.clock()
        while ReturnThreadActive and os.clock() - waitStart < 60 and autoEggsEnabled do
            task.wait(0.3)
        end

        task.wait(1)
    else
        Window:Notify("Авто яйца", "⚠️ Яйцо выпало, повтор...", "warn", 3)
        Steal.CarryUid = nil
        Steal.CarryAreaId = nil
        task.wait(0.5)
    end
end

local trapOriginalCanTouch = {}
local trapConnections = {}
local trapDescendantConnections = {}

local function disarmTrap(trap)
    if not trap or not trap.Parent then return end
    if trap:GetAttribute("Owner") == LP.Name then return end

    local function disablePart(part)
        if part:IsA("BasePart") and trapOriginalCanTouch[part] == nil then
            trapOriginalCanTouch[part] = part.CanTouch
            pcall(function()
                part.CanTouch = false
            end)
        end
    end

    disablePart(trap)
    for _, desc in ipairs(trap:GetDescendants()) do
        disablePart(desc)
    end

    local conn = trap.DescendantAdded:Connect(function(child)
        if autoEggsEnabled then
            disablePart(child)
        end
    end)

    table.insert(trapDescendantConnections, conn)
end

local function scanAllTraps()
    for _, trap in ipairs(CollectionService:GetTagged("PlacedTrap")) do
        disarmTrap(trap)
    end
end

local function restoreAllTraps()
    for part, canTouch in pairs(trapOriginalCanTouch) do
        if part and part.Parent then
            pcall(function()
                part.CanTouch = canTouch
            end)
        end
    end
    table.clear(trapOriginalCanTouch)
end

local function startAntiTrap()
    scanAllTraps()

    local conn = CollectionService:GetInstanceAddedSignal("PlacedTrap"):Connect(function(trap)
        task.defer(disarmTrap, trap)
    end)

    table.insert(trapConnections, conn)
end

local function stopAntiTrap()
    for _, conn in ipairs(trapConnections) do
        pcall(function()
            conn:Disconnect()
        end)
    end
    table.clear(trapConnections)

    for _, conn in ipairs(trapDescendantConnections) do
        pcall(function()
            conn:Disconnect()
        end)
    end
    table.clear(trapDescendantConnections)

    restoreAllTraps()
end

local function startAutoEggs()
    prePointDone = false
    isHoldingPrompt = false
    lockedPrompt = nil
    Steal.Active = false
    Steal.Carrying = false
    ReturnThreadActive = false

    startAntiTrap()
    Window:Notify("Anti Trap", "Ловушки отключены", "info")
    Log("=== Авто яйца ВКЛ ===")

    autoEggsThread = task.spawn(function()
        while autoEggsEnabled do
            local ok, err = pcall(autoEggsLoop)
            if not ok then
                Log("autoEggsLoop ERROR:", tostring(err))
            end
            task.wait(0.5)
        end
    end)
end

local function stopAutoEggs()
    isHoldingPrompt = false
    lockedPrompt = nil
    Steal.Active = false
    ReturnThreadActive = false

    stopAntiTrap()
    Window:Notify("Anti Trap", "Ловушки восстановлены", "info")
    Log("=== Авто яйца ВЫКЛ ===")

    local humanoid = getHumanoid()
    if humanoid then
        humanoid:MoveTo(humanoid.RootPart and humanoid.RootPart.Position or Vector3.new(0, 0, 0))
    end
end

