local function GetFieldEggs()
    local eggState = EggStateModule

    if type(eggState) == "table" and type(eggState.ReadFieldEggs) == "function" then
        local records = nil
        task.spawn(function()
            local ok, result = pcall(eggState.ReadFieldEggs)
            ok = ok and type(result) == "table"
            ok = ok and type(result.Records) == "table"
            ok = ok and next(result.Records) ~= nil
            if ok then
                records = result.Records
            end
        end)

        if records then
            return records
        end
    end

    local networking = ReplicatedStorage:FindFirstChild("Packages")
    networking = networking and networking:FindFirstChild("Networking")
    local rfSnapshot = networking and networking:FindFirstChild("RF/EggWorld/AskFieldEggSnapshot")

    if not rfSnapshot or not rfSnapshot:IsA("RemoteFunction") then
        return nil
    end

    local records = nil
    local done = false
    task.spawn(function()
        local ok, result = pcall(rfSnapshot.InvokeServer, rfSnapshot)
        ok = ok and type(result) == "table"
        ok = ok and type(result.Records) == "table"
        if ok then
            records = result.Records
        end
        done = true
    end)

    local startTime = os.clock()
    while not done and os.clock() - startTime < 4 do
        RunService.Heartbeat:Wait()
    end

    return records
end

local function FindNearestEggNear(targetPos, radius)
    radius = radius or 100
    local records = GetFieldEggs()
    if not records then return nil end

    local nearest = nil
    local nearestDist = radius

    for _, record in pairs(records) do
        if type(record) == "table"
            and record.State == "Slot"
            and typeof(record.BottomCFrame) == "CFrame"
        then
            local dist = (record.BottomCFrame.Position - targetPos).Magnitude
            if dist < nearestDist then
                nearestDist = dist
                nearest = record
            end
        end
    end

    return nearest
end

