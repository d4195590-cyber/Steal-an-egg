local function DoAntiGuardTP()
    if AntiGuardBusy then return end
    AntiGuardBusy = true
    
    task.spawn(function()
        local root = getRoot()
        local humanoid = getHumanoid()
        if not root or not humanoid then 
            AntiGuardBusy = false
            return 
        end
        
        local originalPos = root.Position
        Log("Анти охранник: старт")
        
        for i = 1, 4 do
            root = getRoot()
            humanoid = getHumanoid()
            if root and humanoid then
                pcall(function()
                    root.CFrame = CFrame.new(AntiGuardTarget)
                    root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                    local lookVector = root.CFrame.LookVector
                    local forwardPos = AntiGuardTarget + (lookVector * 50)
                    humanoid:MoveTo(forwardPos)
                end)
            end
            
            RunService.Heartbeat:Wait()
            
            root = getRoot()
            humanoid = getHumanoid()
            if root and humanoid then
                pcall(function()
                    root.CFrame = CFrame.new(originalPos)
                    root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                    local lookVector = root.CFrame.LookVector
                    local forwardPos = originalPos + (lookVector * 50)
                    humanoid:MoveTo(forwardPos)
                end)
            end
            
            RunService.Heartbeat:Wait()
        end
        
        Log("Анти охранник: завершено")
        task.wait(0.5)
        AntiGuardBusy = false
    end)
end

local function StartReturnThread()
