                    Steal.CarryUid = nil
                    Steal.CarryAreaId = nil

                    ReturnThreadActive = false
                    Log("Поток возврата: яйцо сдано!")
                    break
                end
            end

            task.wait(0.1)
        end

        ReturnThread = nil
    end)
end

