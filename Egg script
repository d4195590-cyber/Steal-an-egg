local function isPlayerInRadius(player, radius)
    local root = getRoot()
    if not root then return false end

    if player == LP then return false end
    if not player.Character then return false end

    local hum = player.Character:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end

    local targetRoot = player.Character:FindFirstChild("HumanoidRootPart")
    if not targetRoot then return false end

    local dist = (root.Position - targetRoot.Position).Magnitude
    return dist <= radius
end

local function autoBatLoop()
    local humanoid = getHumanoid()
    if not humanoid or humanoid.Health <= 0 then return end

    local root = getRoot()
    if not root then return end

    local equippedBat = getEquippedBat()

    if not equippedBat then
        equipBat()
        return
    end

    local targetFound = false
    local nearestTarget = nil
    local nearestDist = math.huge

    for _, player in ipairs(Players:GetPlayers()) do
        if isPlayerInRadius(player, 12) then
            targetFound = true

            local targetRoot = player.Character:FindFirstChild("HumanoidRootPart")
            if targetRoot then
                local dist = (root.Position - targetRoot.Position).Magnitude
                if dist < nearestDist then
                    nearestDist = dist
                    nearestTarget = player
                end
            end
        end
    end

    if targetFound then
        if nearestTarget then
            local targetRoot = nearestTarget.Character:FindFirstChild("HumanoidRootPart")
            if targetRoot then
                local lookAt = CFrame.new(root.Position, Vector3.new(targetRoot.Position.X, root.Position.Y, targetRoot.Position.Z))
                root.CFrame = lookAt
            end
        end

        pcall(function()
            equippedBat:Activate()
        end)
    end
end

