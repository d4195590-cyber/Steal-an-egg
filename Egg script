    ReturnThread = task.spawn(function()
        local lastLog = 0

        while ReturnThreadActive and autoEggsEnabled do
            if not Steal.Carrying then
                Log("Поток возврата: яйцо отпущено, выходим")
                ReturnThreadActive = false
                break
            end

            local humanoid = getHumanoid()
            local root = getRoot()

            if humanoid and root and humanoid.Health > 0 then
                pcall(function()
                    humanoid:MoveTo(RETURN_POINT)
                end)

